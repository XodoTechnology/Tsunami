# Tsunami configuration

[network]
use_ipv4 = true
use_ipv6 = true
# UDP tracker bind addresses (one socket set per family, SO_REUSEPORT)
bind_ipv4 = "0.0.0.0:6881"
bind_ipv6 = "[::]:6881"
# Kernel socket receive buffer per UDP socket (0 = OS default ~200KB).
# For high pps set 16-64MiB. Linux doubles the value you set.
socket_recv_buffer = 16777216
# io_uring entries per worker = RX provided buffers (2KiB each) + TX pool
# (~4KiB each). 4096 -> ~8MiB RX + ~17MiB TX per worker.
ring_size = 4096
# Worker threads; 0 = number of online CPUs. One io_uring each.
socket_workers = 0
# UDP RX backend:
#   "io_uring"  - multishot recvmsg on a UDP socket (default, lowest CPU)
#   "af_packet" - PACKET_RX_RING tap + kernel hash-fanout across workers;
#                parses L2/L3/L4 in userspace, sends replies via UDP sockets.
#                Trades ~1.5x CPU for much lower burst loss (kernel ring
#                absorbs floods that overflow UDP socket buffers).
#                Needs root/CAP_NET_RAW. Interface auto-detected from the
#                default route; override with TSUNAMI_PACKET_IFACE.
rx_backend = "io_uring"
# Shards per IP family for swarm state (power of two). More = less contention.
swarm_shards = 256

[protocol]
# Announce interval reported to peers (seconds)
peer_announce_interval = 1800
# Peers not announcing within this window are expired (seconds)
max_peer_age = 2700
# Max peers returned per announce
max_response_peers = 50
# Max info hashes honored per UDP scrape
max_scrape_torrents = 100
# Connection-id validity window (seconds)
max_connection_age = 300
# Store peer_id per peer (~+40B/peer). Needed for HTTP compact=0 peer_id
# echo and per-peer client detail. Disable at very large scale.
store_peer_id = false
# Count announces per client (BEP20 prefix) for /api/clients. Cheap.
client_stats = true
# Honor a client-supplied IP in announce (BEP-15 `ip` field / BEP-3 `ip=`)
# as the peer's swarm address — for privacy-aware clients announcing via a
# relay or wanting a non-source IP published. The connection IP is still
# used for conn-id validation, rate limits and access checks.
# WARNING: lets any client inject arbitrary IPs (swarm poisoning). Keep
# false unless you trust your peer population; pair with access_list.
allow_client_ip = false
# peer_id prefixes excluded from /api/stats top_clients — keeps test/loadgen
# traffic (peer_id "-TS…") out of client stats. Protocol handling unaffected.
client_stats_ignore = ["-TS"]

[http]
enable = true
bind = "0.0.0.0:8080"
# HTTP worker threads (SO_REUSEPORT listeners)
threads = 4
max_request_bytes = 16384
# Allow `GET /scrape` with NO info_hash params to return stats for ALL
# tracked torrents (BEP-12 "full scrape", same format opentracker uses).
# HTTP only — UDP scrape is per-hash-list by design (see DEPLOYMENT.md).
full_scrape = false
# Header carrying the real client IP when behind a reverse proxy / LB you
# control, e.g. "X-Forwarded-For" or "X-Real-IP". Empty = use TCP peer addr.
# ONLY set this when the proxy always overwrites the header, else clients
# can spoof their IP. Applies to /announce, /scrape, /bep15 and WebSocket.
proxy_ip_header = ""
# Serve a self-contained HTML stats dashboard at `/` and `/dashboard`.
dashboard = true

# --- Admin/stats route protection ---
# The public tracker endpoints (/announce, /scrape, /bep15, WebSocket) are
# NEVER gated — peers must reach them. These only protect the operational
# routes: /api/*, /metrics, /dashboard and /.
# HTTP Basic-auth for admin routes. Empty user = no password required.
#admin_user = "admin"
#admin_password = "change-me"
# Optional source-IP allowlist for admin routes: exact IPs or CIDRs.
# Matching IPs bypass password auth entirely (for Prometheus/Grafana).
# Empty = no IP bypass. Non-listed IPs get 401 (if user set) or 403.
#admin_allowlist = ["10.0.0.0/8", "192.168.1.5", "fd00::/8"]
# Mask peer IPs in /api/torrent/{hash} peer lists so stats consumers see
# only first+last parts (IPv4 a.xxx.xxx.d, IPv6 s0:s1:xxxx:xxxx::s7) instead of full
# addresses. Tracker protocol responses always carry full IPs — peers need
# them to connect. Default true; set false to expose full IPs.
mask_peer_ips = true

[cleaning]
# Seconds between peer-expiry passes
interval = 30
# Cleaner threads (strided shard subsets)
threads = 2

[statistics]
# Log a stats line + refresh rates this often (seconds); 0 = disabled
log_interval = 10
# Write full JSON snapshot here every log_interval ("" = disabled)
write_json_to = ""

[access_list]
# "off" | "allow" | "deny" — info hashes, one hex per line
mode = "off"
file = "access.txt"
reload_on_sighup = true

[scrape_export]
enable = false
# Write scrape export every N cleaning cycles (0 = every cycle)
every_cycles = 0
path = "scrape.txt"

[snapshot]
# Periodically dump peer state to disk and restore it on startup, so a
# restart doesn't mean ~30 min of clients re-announcing. Peers whose
# valid_until passed while down are skipped on load. peer_id side-table
# is NOT restored (repopulates on next announce).
enable = false
path = "tsunami.snap"
# Seconds between dumps; 0 = only on SIGINT/SIGTERM shutdown.
interval_secs = 300

[ratelimit]
# DoS shedding via per-worker token buckets on the expensive store paths.
# Rate is PER SOCKET WORKER; effective global ceiling ≈ value × socket_workers.
# 0 = unlimited. Connects and parse errors are never limited (cheap handshake).
announce_per_sec = 0
scrape_per_sec = 0
# Token-bucket burst as a multiple of the per-second rate (1.0 = 1s burst).
burst = 1.0

[logging]
# error|warn|info|debug|trace
level = "info"
